# Postgres (Supabase: use the pooled "session" connection string of the postgres role)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sabai_dev
# Supabase project JWT secret (Settings → API). Used to verify user tokens and mint PIN staff tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
PORT=8787
CORS_ORIGINS=http://localhost:3000

# ค่าบริการของร้านเอง (checklist 8.1). ค่าเริ่มต้น "none" = ยังไม่เก็บเงินออนไลน์ เลือกแพ็กเกจแล้วมีผลทันที
#   "manual"    = แพ็กเกจที่แพงกว่าออกเป็นใบแจ้งหนี้ ลูกค้าโอน/พร้อมเพย์ แล้วทีมงานยืนยันผ่าน webhook ที่ลงลายมือชื่อ
#   Omise/Stripe จะมาพร้อมข้อ 8.2 (ต้องมี key จริง)
BILLING_PROVIDER=none
# ใช้ลงลายมือชื่อ webhook (X-Sabai-Signature) — ยาว ≥ 32 ตัวอักษร จำเป็นเมื่อ BILLING_PROVIDER=manual
# BILLING_WEBHOOK_SECRET=
# บัญชีที่ลูกค้าโอนเข้า (ต้องมีพร้อมเพย์หรือเลขบัญชีอย่างน้อยหนึ่งอย่าง)
# BILLING_PROMPTPAY_ID=
# BILLING_BANK_NAME=
# BILLING_BANK_ACCOUNT_NO=
# BILLING_BANK_ACCOUNT_NAME=
# งานประจำวัน (ออกใบแจ้งหนี้ต่ออายุ, ค้างชำระ, หมดช่วงผ่อนผัน): รันในโปรเซสนี้ทุกกี่นาที (ค่าเริ่มต้น 60, 0 = ไม่รันที่นี่)
# BILLING_JOB_INTERVAL_MINUTES=60
# ถ้าจะให้ตัวตั้งเวลาภายนอกเรียก POST /v1/billing/run (ส่งใน X-Job-Secret, ≥ 32 ตัวอักษร) ไม่ตั้ง = ไม่มี route นี้
# BILLING_JOB_SECRET=

# ---- Observability (checklist 9.1): ไม่ตั้งอะไร = ปิดทั้งหมด ไม่มีต้นทุน ----
# OpenTelemetry (traces + metrics ผ่าน OTLP/HTTP) ไปยัง collector หรือผู้ให้บริการที่ใช้ เช่น http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# key ของผู้ให้บริการ (มาตรฐาน OpenTelemetry): k1=v1,k2=v2
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=sabai-api
# สัดส่วน trace ใหม่ที่เก็บ 0–1 (ค่าเริ่มต้น 1; trace ที่ผู้เรียกตัดสินใจเก็บแล้วจะเก็บตามเสมอ)
# OTEL_TRACES_SAMPLE_RATIO=1
# รายงานข้อผิดพลาดที่ไม่คาดคิดไปยัง Sentry หรือ GlitchTip (DSN) — ไม่ตั้ง = แค่ log
# ERROR_TRACKING_DSN=
# เวอร์ชันที่ระบุบน trace และรายงาน (ถ้าไม่ตั้ง ใช้ VERCEL_GIT_COMMIT_SHA หรือ GIT_SHA)
# RELEASE=

# ---- ขีดจำกัดกันเดารหัส ----
# ครั้งต่อนาทีที่ยอมให้ใส่ PIN (สลับผู้ใช้/อนุมัติ) ต่อที่อยู่ IP และสาขา ค่าเริ่มต้น 10 — อย่าเพิ่มบน production
# (ชุดทดสอบเบราว์เซอร์ตั้งสูงเพราะเข้าสู่ระบบซ้ำหลายสิบครั้ง)
# PIN_ATTEMPTS_PER_MINUTE=10

# How often (minutes) to delete Idempotency-Key rows older than 24 h. 0 = never in this process.
# IDEMPOTENCY_PURGE_INTERVAL_MINUTES=60
