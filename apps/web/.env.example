# ตัวแปรของหน้าเว็บ (NEXT_PUBLIC_* ถูกฝังตอน build — ผู้ใช้เห็นได้ อย่าใส่ความลับ)

# demo (ค่าเริ่มต้น: ข้อมูลอยู่ในเบราว์เซอร์ ไม่ต้องมีเซิร์ฟเวอร์) หรือ api (ต่อ API จริง)
NEXT_PUBLIC_DATA_SOURCE=demo
# ที่อยู่ API เมื่อใช้โหมด api
# NEXT_PUBLIC_API_URL=http://localhost:8787

# ตัวช่วยเข้าสู่ระบบ: local (dev/CI) หรือ supabase (production)
# NEXT_PUBLIC_AUTH_PROVIDER=local
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# รายงานข้อผิดพลาดที่ไม่คาดคิดในเบราว์เซอร์ไปยัง Sentry หรือ GlitchTip (DSN สาธารณะ — ส่งเฉพาะชนิดข้อผิดพลาด ตำแหน่งโค้ด
# และ path ของหน้าที่ปิดบัง id แล้ว; ไม่ส่ง query string, ข้อความที่พิมพ์ หรือชื่อใคร) ไม่ตั้ง = ไม่ส่งอะไรเลย
# NEXT_PUBLIC_ERROR_TRACKING_DSN=
# ระบุเวอร์ชันบนรายงาน (บน Vercel ใช้ NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA ให้เอง ถ้าเปิด "Automatically expose System Environment Variables")
# NEXT_PUBLIC_RELEASE=
